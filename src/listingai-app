<!-- FOOTER -->
<footer>
  <span class="logo">Listing<span style="color:var(--accent)">AI</span></span>
  Built for real estate professionals who want to spend less time writing and more time selling. © 2025 ListingAI.
</footer>

<!-- AUTH MODAL -->
<div class="modal-overlay" id="auth-modal" style="display:none" onclick="closeModalOverlay(event)">
  <div class="modal">
    <button class="modal-close" onclick="closeModal()">✕</button>
    <h2 id="auth-title">Create your account</h2>
    <p class="modal-sub" id="auth-sub">Free to start. No credit card required.</p>
    <div class="form-group">
      <label>Email address</label>
      <input type="email" id="auth-email" placeholder="you@example.com" />
    </div>
    <div class="form-group">
      <label>Password</label>
      <input type="password" id="auth-password" placeholder="At least 6 characters" />
    </div>
    <div id="auth-error" class="error-msg" style="display:none"></div>
    <button class="btn btn-primary" style="width:100%;justify-content:center;margin-top:6px" id="auth-submit-btn" onclick="handleAuth()">
      Create account
    </button>
    <div class="modal-switch" id="auth-switch">
      Already have an account? <a onclick="toggleAuthMode()">Log in instead</a>
    </div>
  </div>
</div>

<!-- UPGRADE MODAL -->
<div class="modal-overlay" id="upgrade-modal" style="display:none" onclick="closeUpgradeOverlay(event)">
  <div class="modal upgrade-center">
    <button class="modal-close" onclick="document.getElementById('upgrade-modal').style.display='none'">✕</button>
    <div style="font-size:2rem;margin-bottom:12px">🚀</div>
    <h2>You've used your 3 free generations</h2>
    <p>Upgrade to Pro for unlimited generations — write as many listings as you need for just $19.99/month.</p>
    <button class="btn btn-primary btn-large" style="width:100%;justify-content:center" onclick="handleUpgrade()">
      Upgrade to Pro — $19.99/mo →
    </button>
    <div style="font-size:0.78rem;color:var(--text3);margin-top:10px">Cancel anytime. No long-term commitment.</div>
  </div>
</div>

<!-- TOAST -->
<div id="toast" class="toast" style="display:none"></div>

<script>
const API_BASE = 'https://main-backend-k32m.onrender.com';
const SUPABASE_URL = 'https://wzcuzyouymauokijaqjk.supabase.co';
const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Ind6Y3V6eW91eW1hdW9raWphcWprIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzM5NDUyMDAsImV4cCI6MjA4OTUyMTIwMH0.fDuyCZGrCbL9Obd7l6FDnNd5AB-AUytp-3S60KwwKvM';

const { createClient } = supabase;
const sbClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

let currentUser = null;
let currentUserData = null;
let authMode = 'signup';
let outputData = { mls: '', social: '', email: '' };

async function init() {
  const { data: { session } } = await sbClient.auth.getSession();
  if (session) {
    currentUser = session.user;
    await loadUserData();
    renderNav();
  }
  if (new URLSearchParams(window.location.search).get('upgraded') === '1') {
    setTimeout(() => showToast('🎉 You\'re now Pro! Unlimited generations unlocked.', 'success'), 600);
    history.replaceState(null, '', window.location.pathname);
  }
}

async function loadUserData() {
  if (!currentUser) return;
  try {
    const res = await fetch(`${API_BASE}/listingai/user/${encodeURIComponent(currentUser.email)}`);
    if (res.ok) { currentUserData = await res.json(); updateGenCounter(); }
  } catch(e) { console.error(e); }
}

function renderNav() {
  const el = document.getElementById('nav-actions');
  if (currentUser && currentUserData) {
    const plan = currentUserData.plan;
    const manageBtn = plan === 'pro'
      ? `<button class="btn btn-ghost" onclick="handleManageSubscription()" style="font-size:0.8rem">Manage Subscription</button>`
      : '';
    el.innerHTML = `
      <div class="user-pill">
        ${currentUser.email.split('@')[0]}
        <span class="plan-badge ${plan === 'pro' ? 'badge-pro' : 'badge-free'}">${plan}</span>
      </div>
      ${manageBtn}
      <button class="btn btn-ghost" onclick="handleLogout()">Log out</button>
    `;
  } else {
    el.innerHTML = `
      <button class="btn btn-ghost" onclick="openModal('login')">Log in</button>
      <button class="btn btn-primary" onclick="openModal('signup')">Try for free</button>
    `;
  }
}

function updateGenCounter() {
  if (!currentUserData) return;
  const el = document.getElementById('gen-counter');
  if (currentUserData.plan === 'free') {
    el.style.display = 'block';
    document.getElementById('gen-used').textContent = currentUserData.generations_used;
  } else { el.style.display = 'none'; }
}

async function handleGenerate() {
  const input = document.getElementById('property-input').value.trim();
  if (!input) { showToast('Please enter your property details first.', 'error'); return; }
  if (!currentUser) { openModal('signup'); return; }
  if (currentUserData?.plan === 'free' && currentUserData?.generations_used >= 3) {
    document.getElementById('upgrade-modal').style.display = 'flex'; return;
  }

  const btn = document.getElementById('generate-btn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span> Generating…';
  showShimmer();

  try {
    const res = await fetch(`${API_BASE}/listingai/generate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: currentUser.email, property_details: input })
    });
    if (res.status === 402) { document.getElementById('upgrade-modal').style.display = 'flex'; return; }
    if (!res.ok) { const e = await res.json(); throw new Error(e.detail || 'Generation failed'); }

    const data = await res.json();
    outputData = { mls: data.mls, social: data.social, email: data.email };
    currentUserData.generations_used = data.generations_used;
    showOutputs();
    updateGenCounter();
    showToast('✓ Content generated! Click Copy on any card to use it.', 'success');
  } catch(e) {
    showError();
    showToast(e.message || 'Something went wrong. Please try again.', 'error');
  } finally {
    btn.disabled = false;
    btn.innerHTML = 'Generate Content →';
  }
}

function showShimmer() {
  ['mls-output','social-output','email-output'].forEach(id => {
    document.getElementById(id).innerHTML = `
      <div class="shimmer sh-full"></div>
      <div class="shimmer sh-lg"></div>
      <div class="shimmer sh-full"></div>
      <div class="shimmer sh-mid"></div>
      <div class="shimmer sh-sm"></div>
    `;
  });
  ['mls-footer','social-footer','email-footer'].forEach(id => {
    document.getElementById(id).style.display = 'none';
  });
}

function showOutputs() {
  document.getElementById('mls-output').textContent = outputData.mls;
  document.getElementById('social-output').textContent = outputData.social;
  document.getElementById('email-output').textContent = outputData.email;

  // Word / char counts
  const mlsWords = outputData.mls.trim().split(/\s+/).length;
  const socialChars = outputData.social.length;
  const emailWords = outputData.email.trim().split(/\s+/).length;

  document.getElementById('mls-words').textContent = `${mlsWords} words`;
  document.getElementById('social-chars').textContent = `${socialChars} characters`;
  document.getElementById('email-words').textContent = `${emailWords} words`;

  ['mls-footer','social-footer','email-footer'].forEach(id => {
    document.getElementById(id).style.display = 'flex';
  });
}

function showError() {
  ['mls-output','social-output','email-output'].forEach(id => {
    document.getElementById(id).innerHTML = '<div class="placeholder-state"><div class="placeholder-text" style="color:#c0392b">Generation failed. Please try again.</div></div>';
  });
}

function copyOutput(type) {
  const text = outputData[type];
  if (!text) return;
  navigator.clipboard.writeText(text);
  const btn = document.getElementById(`copy-${type}`);
  btn.classList.add('copied');
  btn.innerHTML = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Copied!`;
  setTimeout(() => {
    btn.classList.remove('copied');
    btn.innerHTML = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg> Copy`;
  }, 2200);
}

function openModal(mode) {
  authMode = mode;
  document.getElementById('auth-modal').style.display = 'flex';
  document.getElementById('auth-error').style.display = 'none';
  document.getElementById('auth-email').value = '';
  document.getElementById('auth-password').value = '';
  if (mode === 'login') {
    document.getElementById('auth-title').textContent = 'Welcome back';
    document.getElementById('auth-sub').textContent = 'Log in to your ListingAI account.';
    document.getElementById('auth-submit-btn').textContent = 'Log in';
    document.getElementById('auth-switch').innerHTML = `Don't have an account? <a onclick="toggleAuthMode()">Sign up free</a>`;
  } else {
    document.getElementById('auth-title').textContent = 'Create your account';
    document.getElementById('auth-sub').textContent = 'Free to start. No credit card required.';
    document.getElementById('auth-submit-btn').textContent = 'Create account';
    document.getElementById('auth-switch').innerHTML = `Already have an account? <a onclick="toggleAuthMode()">Log in instead</a>`;
  }
}
function toggleAuthMode() { openModal(authMode === 'login' ? 'signup' : 'login'); }
function closeModal() { document.getElementById('auth-modal').style.display = 'none'; }
function closeModalOverlay(e) { if (e.target === document.getElementById('auth-modal')) closeModal(); }
function closeUpgradeOverlay(e) { if (e.target === document.getElementById('upgrade-modal')) document.getElementById('upgrade-modal').style.display = 'none'; }

async function handleAuth() {
  const email = document.getElementById('auth-email').value.trim();
  const password = document.getElementById('auth-password').value;
  if (!email || !password) { showAuthErr('Please fill in both fields.'); return; }

  const btn = document.getElementById('auth-submit-btn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner spinner-dark"></span>';

  try {
    let result;
    if (authMode === 'signup') {
      result = await sbClient.auth.signUp({ email, password });
      if (result.error) throw result.error;
      await fetch(`${API_BASE}/listingai/user`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });
    } else {
      result = await sbClient.auth.signInWithPassword({ email, password });
      if (result.error) throw result.error;
    }
    currentUser = result.data.user;
    await loadUserData();
    renderNav();
    closeModal();
    showToast(authMode === 'signup' ? '✓ Account created! You have 3 free generations.' : '✓ Welcome back!', 'success');
  } catch(e) {
    showAuthErr(e.message || 'Authentication failed.');
  } finally {
    btn.disabled = false;
    btn.textContent = authMode === 'login' ? 'Log in' : 'Create account';
  }
}

function showAuthErr(msg) {
  const el = document.getElementById('auth-error');
  el.textContent = msg; el.style.display = 'block';
}

async function handleManageSubscription() {
  try {
    const res = await fetch(`${API_BASE}/listingai/create-portal-session`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: currentUser.email,
        return_url: window.location.href
      })
    });
    const data = await res.json();
    if (data.url) { window.location.href = data.url; }
    else throw new Error('No portal URL');
  } catch(e) {
    showToast('Could not open subscription portal: ' + e.message, 'error');
  }
}

async function handleLogout() {
  await sbClient.auth.signOut();
  currentUser = null; currentUserData = null;
  renderNav();
  showToast('Logged out successfully.', 'success');
}

async function handleUpgrade() {
  if (!currentUser) { document.getElementById('upgrade-modal').style.display = 'none'; openModal('signup'); return; }
  const btn = document.getElementById('upgrade-btn');
  if (btn) { btn.disabled = true; btn.textContent = 'Loading…'; }
  try {
    const res = await fetch(`${API_BASE}/listingai/create-checkout-session`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: currentUser.email,
        success_url: window.location.origin + '/?upgraded=1',
        cancel_url: window.location.href
      })
    });
    const data = await res.json();
    if (data.url) { window.location.href = data.url; }
    else throw new Error('No checkout URL');
  } catch(e) {
    showToast('Checkout failed: ' + e.message, 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = 'Upgrade to Pro →'; }
  }
}

let toastTimer;
function showToast(msg, type = 'success') {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = `toast ${type}`;
  t.style.display = 'flex';
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => { t.style.display = 'none'; }, 4000);
}

function scrollToTool() {
  document.getElementById('tool').scrollIntoView({ behavior: 'smooth' });
}

init();
</script>
</body>
</html>
