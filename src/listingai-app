      <div class="panel-body">
        <textarea id="property-input" placeholder="Example:
4 bed / 2.5 bath in Liverpool, NY. 2,100 sq ft, built 2005. Updated kitchen with granite countertops and stainless appliances. Master suite with walk-in closet. Finished basement, 2-car garage. Large fenced backyard with patio. Top-rated Northside school district. Asking $349,900."></textarea>
        <div class="input-hint">
          <strong>💡 Tip:</strong> The more details you include — price, features, neighborhood, school district — the better your results will be. You don't need perfect grammar, just the facts.
        </div>
      </div>
      <div class="panel-footer">
        <div class="gen-counter" id="gen-counter" style="display:none">
          <strong id="gen-used">0</strong> of 3 free generations used
        </div>
        <div style="flex:1"></div>
        <button class="btn btn-primary" id="generate-btn" onclick="handleGenerate()">
          Generate Content →
        </button>
      </div>
    </div>

    <!-- Outputs -->
    <div class="outputs">

      <!-- MLS -->
      <div class="output-card">
        <div class="output-header">
          <div class="output-meta">
            <div class="output-title">
              <div class="output-icon icon-mls">🏡</div>
              MLS Listing Description
            </div>
            <div class="output-desc">Paste this into Zillow, Realtor.com, or your MLS system when creating a new listing. This is the main description buyers read when browsing properties online.</div>
          </div>
          <button class="copy-btn" id="copy-mls" onclick="copyOutput('mls')">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
            Copy
          </button>
        </div>
        <div class="output-body" id="mls-output">
          <div class="placeholder-state">
            <div class="placeholder-icon">🏡</div>
            <div class="placeholder-text">Your MLS description will appear here after you generate</div>
          </div>
        </div>
        <div class="output-footer" id="mls-footer" style="display:none">
          <span id="mls-words">—</span>
          <span>Ready to paste into your MLS system</span>
        </div>
      </div>

      <!-- Social -->
      <div class="output-card">
        <div class="output-header">
          <div class="output-meta">
            <div class="output-title">
              <div class="output-icon icon-social">📱</div>
              Social Media Post
            </div>
            <div class="output-desc">Copy this and post it on your Facebook or Instagram page to announce the new listing. It includes hashtags to help more people find it.</div>
          </div>
          <button class="copy-btn" id="copy-social" onclick="copyOutput('social')">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
            Copy
          </button>
        </div>
        <div class="output-body" id="social-output">
          <div class="placeholder-state">
            <div class="placeholder-icon">📱</div>
            <div class="placeholder-text">Your Instagram/Facebook post will appear here after you generate</div>
          </div>
        </div>
        <div class="output-footer" id="social-footer" style="display:none">
          <span id="social-chars">—</span>
          <span>Ready to post on Facebook or Instagram</span>
        </div>
      </div>

      <!-- Email -->
      <div class="output-card">
        <div class="output-header">
          <div class="output-meta">
            <div class="output-title">
              <div class="output-icon icon-email">✉️</div>
              Buyer Follow-Up Email
            </div>
            <div class="output-desc">Send this to anyone who asked about the property, attended an open house, or scheduled a showing. It's warm and professional, and ends with a clear call to action.</div>
          </div>
          <button class="copy-btn" id="copy-email" onclick="copyOutput('email')">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
            Copy
          </button>
        </div>
        <div class="output-body" id="email-output">
          <div class="placeholder-state">
            <div class="placeholder-icon">✉️</div>
            <div class="placeholder-text">Your buyer follow-up email will appear here after you generate</div>
          </div>
        </div>
        <div class="output-footer" id="email-footer" style="display:none">
          <span id="email-words">—</span>
          <span>Ready to send to interested buyers</span>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- PRICING -->
<section id="pricing" class="pricing-section">
  <div class="pricing-inner">
    <div class="section-eyebrow">Pricing</div>
    <div class="section-title">Simple pricing. No surprises.</div>
    <p style="color:var(--text2);font-size:0.95rem;">Start for free and upgrade when you're ready. Cancel anytime.</p>
    <div class="pricing-grid">
