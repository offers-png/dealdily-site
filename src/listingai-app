          <li><span class="check">✓</span> 3 lifetime generations</li>
          <li><span class="check">✓</span> MLS description, social post & email</li>
          <li><span class="check">✓</span> Copy to clipboard</li>
          <li><span class="xmark">✗</span> <span style="color:var(--text3)">Unlimited generations</span></li>
          <li><span class="xmark">✗</span> <span style="color:var(--text3)">Generation history</span></li>
        </ul>
        <button class="btn btn-ghost" style="width:100%;justify-content:center" onclick="openModal('signup')">Start for free</button>
      </div>
      <div class="pricing-card featured">
        <div class="price-plan">Pro</div>
        <div class="price-amount"><sup>$</sup>19<small style="font-size:1.3rem;font-family:sans-serif;font-weight:500">.99</small></div>
        <div class="price-period">per month · cancel anytime</div>
        <ul class="price-features">
          <li><span class="check">✓</span> <strong>Unlimited</strong> generations</li>
          <li><span class="check">✓</span> MLS description, social post & email</li>
          <li><span class="check">✓</span> Copy to clipboard</li>
          <li><span class="check">✓</span> Generation history</li>
          <li><span class="check">✓</span> Priority support</li>
        </ul>
        <button class="btn btn-primary" style="width:100%;justify-content:center" id="upgrade-btn" onclick="handleUpgrade()">Upgrade to Pro →</button>
