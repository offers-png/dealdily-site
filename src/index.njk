<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DealDily — AI Tools Built by a Real Business Owner</title>
<link href="https://fonts.googleapis.com/css2?family=Clash+Display:wght@400;500;600;700&family=Cabinet+Grotesk:wght@400;500;700;800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,600;0,9..144,700;1,9..144,400&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
<style>
:root {
  --cream: #faf7f2;
  --warm-white: #fff9f4;
  --ink: #1a1614;
  --ink2: #3d3530;
  --muted: #8a7d74;
  --border: #e8e0d8;
  --border2: #d4c9be;
  --coral: #e8533a;
  --coral-light: #fdf0ed;
  --coral-mid: #f4b5a8;
  --teal: #2a7d6f;
  --teal-light: #e8f5f2;
  --amber: #d4820a;
  --amber-light: #fef4e0;
  --indigo: #3b4fd8;
  --indigo-light: #eef0fc;
  --rose: #c9365a;
  --rose-light: #fdeef2;
  --sage: #4a7c59;
  --sage-light: #eef5f0;
  --ff: 'Fraunces', Georgia, serif;
  --fb: 'DM Sans', sans-serif;
  --sw: 270px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: var(--fb);
  background: var(--cream);
  color: var(--ink);
  overflow-x: hidden;
  line-height: 1.6;
}

a { color: inherit; text-decoration: none; }
button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }

/* ── LAYOUT ── */
.layout { display: flex; min-height: 100vh; }
.main { margin-left: var(--sw); flex: 1; min-width: 0; }
.page { display: none; }
.page.active { display: block; }

/* ── SIDEBAR ── */
.sidebar {
  width: var(--sw);
  position: fixed;
  top: 0; left: 0; bottom: 0;
  background: var(--warm-white);
  border-right: 1.5px solid var(--border);
  display: flex;
  flex-direction: column;
  z-index: 200;
  transition: transform .3s ease;
}

.sb-logo {
  padding: 1.75rem 1.5rem 1.5rem;
  border-bottom: 1.5px solid var(--border);
}

.sb-brand {
  display: flex;
  align-items: center;
  gap: .6rem;
  font-family: var(--ff);
  font-size: 1.55rem;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -.03em;
}

.sb-dot {
  width: 10px; height: 10px;
  border-radius: 50%;
  background: var(--coral);
  flex-shrink: 0;
}

.sb-tagline {
  font-size: .72rem;
  color: var(--muted);
  margin-top: .3rem;
  letter-spacing: .02em;
}

.sb-nav { flex: 1; padding: 1.25rem .875rem; overflow-y: auto; }
.sb-nav::-webkit-scrollbar { width: 2px; }
.sb-nav::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 2px; }

.sb-grp {
  font-size: .58rem;
  font-weight: 700;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: var(--muted);
  padding: .875rem .625rem .3rem;
}

.sb-btn {
  display: flex;
  align-items: center;
  gap: .6rem;
  width: 100%;
  padding: .5rem .75rem;
  border-radius: 8px;
  color: var(--ink2);
  font-size: .85rem;
  font-weight: 500;
  transition: all .15s;
  position: relative;
  text-align: left;
}

.sb-btn:hover { background: var(--cream); color: var(--ink); }

.sb-btn.on {
  background: var(--coral-light);
  color: var(--coral);
  font-weight: 600;
}

.sb-btn.on::before {
  content: '';
  position: absolute;
  left: 0; top: 20%; bottom: 20%;
  width: 2.5px;
  border-radius: 0 2px 2px 0;
  background: var(--coral);
}

.sb-ico { font-size: .9rem; width: 16px; text-align: center; flex-shrink: 0; }

.sb-badge {
  margin-left: auto;
  font-size: .57rem;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 100px;
  letter-spacing: .03em;
  text-transform: uppercase;
}

.sb-badge.hot { background: #fdeee9; color: var(--coral); }
.sb-badge.new { background: var(--teal-light); color: var(--teal); }

.sb-amazon {
  display: flex;
  align-items: center;
  gap: .6rem;
  width: 100%;
  padding: .65rem .75rem;
  border-radius: 9px;
  background: var(--amber-light);
  border: 1.5px solid #f0d49a;
  color: var(--amber);
  font-size: .85rem;
  font-weight: 700;
  transition: all .18s;
  margin-bottom: .5rem;
}

.sb-amazon:hover { background: #fdecc8; }

.sb-foot {
  padding: 1rem 1.5rem;
  border-top: 1.5px solid var(--border);
  font-size: .72rem;
  color: var(--muted);
}

.sb-foot a { color: var(--muted); transition: color .15s; }
.sb-foot a:hover { color: var(--coral); }

/* ── MOB ── */
.mob-btn {
  display: none;
  position: fixed;
  top: 1rem; left: 1rem;
  z-index: 300;
  width: 40px; height: 40px;
  border-radius: 10px;
  background: white;
  border: 1.5px solid var(--border);
  color: var(--ink);
  font-size: 1rem;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 12px rgba(0,0,0,.08);
}

.ovl {
  display: none;
  position: fixed; inset: 0;
  background: rgba(26,22,20,.4);
  z-index: 150;
  backdrop-filter: blur(3px);
}

/* ── PAGE HEADER ── */
.pt {
  padding: 3rem 3rem 2.5rem;
  border-bottom: 1.5px solid var(--border);
  background: var(--warm-white);
  position: relative;
  overflow: hidden;
}

.pt-accent {
  position: absolute;
  top: -60px; right: -60px;
  width: 220px; height: 220px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232,83,58,.1) 0%, transparent 70%);
  pointer-events: none;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  font-size: .68rem;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--coral);
  background: var(--coral-light);
  border: 1.5px solid var(--coral-mid);
  padding: 3px 12px;
  border-radius: 100px;
  margin-bottom: 1rem;
}

.pt h1 {
  font-family: var(--ff);
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -.04em;
  color: var(--ink);
  margin-bottom: .75rem;
}

.pt h1 em {
  font-style: italic;
  color: var(--coral);
}

.pt p {
  color: var(--muted);
  font-size: .92rem;
  max-width: 480px;
  line-height: 1.75;
}

.pb { padding: 2.5rem 3rem; }

/* ── SECTION LABEL ── */
.sl {
  display: flex;
  align-items: center;
  gap: .75rem;
  font-size: .62rem;
  font-weight: 700;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 2rem 0 1.25rem;
}

.sl::after {
  content: '';
  flex: 1;
  height: 1.5px;
  background: var(--border);
}

/* ── CARD GRID ── */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.25rem;
  margin-bottom: 2rem;
}

/* ── PRODUCT CARD ── */
.pc {
  background: white;
  border: 1.5px solid var(--border);
  border-radius: 16px;
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  gap: .6rem;
  position: relative;
  transition: all .22s ease;
  overflow: hidden;
}

.pc:hover {
  border-color: var(--border2);
  transform: translateY(-3px);
  box-shadow: 0 12px 36px rgba(26,22,20,.1);
}

.pc::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
}

.pc-coral::before { background: var(--coral); }
.pc-teal::before { background: var(--teal); }
.pc-amber::before { background: var(--amber); }
.pc-indigo::before { background: var(--indigo); }
.pc-rose::before { background: var(--rose); }
.pc-sage::before { background: var(--sage); }
.pc-cyan::before { background: #0891b2; }
.pc-orange::before { background: #ea7c4a; }

.pci { font-size: 1.75rem; line-height: 1; margin-bottom: .1rem; }

.pct {
  display: inline-block;
  font-size: .6rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 2px 9px;
  border-radius: 100px;
}

.t-coral { background: var(--coral-light); color: var(--coral); }
.t-teal { background: var(--teal-light); color: var(--teal); }
.t-amber { background: var(--amber-light); color: var(--amber); }
.t-indigo { background: var(--indigo-light); color: var(--indigo); }
.t-rose { background: var(--rose-light); color: var(--rose); }
.t-sage { background: var(--sage-light); color: var(--sage); }
.t-cyan { background: #e0f5fa; color: #0e7490; }
.t-orange { background: #fef1ea; color: #c2572a; }

.pc h3 {
  font-family: var(--ff);
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: -.02em;
  line-height: 1.3;
}

.pcd {
  font-size: .83rem;
  color: var(--muted);
  line-height: 1.7;
  flex: 1;
}

.pcf {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .75rem;
  padding-top: 1rem;
  border-top: 1.5px solid var(--border);
  margin-top: auto;
}

.pcp {
  font-family: var(--ff);
  font-size: 1.45rem;
  font-weight: 600;
  color: var(--ink);
  line-height: 1;
}

.pcp small {
  display: block;
  font-size: .65rem;
  color: var(--muted);
  font-weight: 400;
  font-family: var(--fb);
  margin-top: 3px;
}

/* ── BUTTONS ── */
.btn {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  font-family: var(--fb);
  font-size: .78rem;
  font-weight: 600;
  padding: 8px 18px;
  border-radius: 8px;
  white-space: nowrap;
  transition: all .18s;
  text-decoration: none;
  cursor: pointer;
  border: none;
}

.btn-p {
  background: var(--coral);
  color: white;
  box-shadow: 0 2px 10px rgba(232,83,58,.3);
}

.btn-p:hover {
  background: #d4442b;
  box-shadow: 0 4px 16px rgba(232,83,58,.4);
  transform: translateY(-1px);
}

.btn-g {
  background: var(--teal-light);
  color: var(--teal);
  border: 1.5px solid #b5dcd6;
}

.btn-g:hover { background: #d4ede9; transform: translateY(-1px); }

.btn-ghost {
  background: white;
  color: var(--ink2);
  border: 1.5px solid var(--border);
}

.btn-ghost:hover { border-color: var(--border2); color: var(--ink); }

/* ── AMAZON GRID ── */
.ag {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1.25rem;
  margin-bottom: 2rem;
}

.ac {
  background: white;
  border: 1.5px solid var(--border);
  border-radius: 14px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: all .22s;
}

.ac:hover {
  border-color: var(--border2);
  transform: translateY(-3px);
  box-shadow: 0 10px 30px rgba(26,22,20,.09);
}

.ac:hover .ai img { transform: scale(1.05); }

.ai {
  aspect-ratio: 1;
  background: #f8f5f1;
  overflow: hidden;
  position: relative;
}

.ai img {
  width: 100%; height: 100%;
  object-fit: contain;
  padding: 1.25rem;
  transition: transform .3s ease;
}

.apb {
  position: absolute;
  top: .6rem; right: .6rem;
  font-family: var(--ff);
  font-size: .82rem;
  font-weight: 600;
  color: white;
  background: var(--coral);
  padding: 2px 9px;
  border-radius: 6px;
}

.ab {
  padding: .875rem 1rem .75rem;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: .35rem;
}

.at {
  font-family: var(--ff);
  font-size: .82rem;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.ah {
  font-size: .73rem;
  color: var(--muted);
  line-height: 1.55;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.af {
  padding: .6rem 1rem .875rem;
  display: flex;
  align-items: center;
  gap: .6rem;
  border-top: 1.5px solid var(--border);
}

.apr {
  font-family: var(--ff);
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--ink);
  flex: 1;
}

.abtn {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  font-size: .72rem;
  font-weight: 600;
  padding: 6px 13px;
  border-radius: 7px;
  background: var(--coral);
  color: white;
  white-space: nowrap;
  transition: all .18s;
}

.abtn:hover { background: #d4442b; transform: translateY(-1px); }

/* ── FILTER ── */
.fb-wrap {
  display: flex;
  gap: .4rem;
  flex-wrap: wrap;
  margin-bottom: 1.5rem;
  align-items: center;
}

.fl { font-size: .72rem; color: var(--muted); margin-right: .2rem; }

.fb {
  font-size: .72rem;
  font-weight: 500;
  padding: 5px 14px;
  border-radius: 100px;
  border: 1.5px solid var(--border);
  background: white;
  color: var(--muted);
  cursor: pointer;
  transition: all .15s;
}

.fb:hover, .fb.on {
  background: var(--coral-light);
  border-color: var(--coral-mid);
  color: var(--coral);
}

/* ── AFF ── */
.aff-list {
  display: flex;
  flex-direction: column;
  gap: .75rem;
  margin-bottom: 1.75rem;
}

.aff-row {
  display: flex;
  align-items: center;
  gap: 1rem;
  background: white;
  border: 1.5px solid var(--border);
  border-radius: 12px;
  padding: .875rem 1.1rem;
  transition: all .18s;
}

.aff-row:hover {
  border-color: var(--border2);
  box-shadow: 0 4px 16px rgba(26,22,20,.07);
  transform: translateX(4px);
}

.aff-ico {
  width: 42px; height: 42px;
  border-radius: 10px;
  background: var(--cream);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  flex-shrink: 0;
  border: 1.5px solid var(--border);
}

.aff-info { flex: 1; }
.aff-info h4 { font-size: .87rem; font-weight: 600; color: var(--ink); margin-bottom: .1rem; }
.aff-info p { font-size: .75rem; color: var(--muted); }
.aff-comm { font-size: .62rem; font-weight: 700; padding: 2px 8px; border-radius: 100px; background: var(--teal-light); color: var(--teal); white-space: nowrap; flex-shrink: 0; }
.aff-arr { color: var(--muted); flex-shrink: 0; font-size: .8rem; }

/* ── STATS ── */
.sg {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
  margin-bottom: 1.75rem;
}

.sc {
  background: white;
  border: 1.5px solid var(--border);
  border-radius: 14px;
  padding: 1.75rem 1.5rem;
  text-align: center;
}

.sn {
  font-family: var(--ff);
  font-size: 2.8rem;
  font-weight: 700;
  color: var(--coral);
  line-height: 1;
  display: block;
  letter-spacing: -.04em;
}

.sl2 { font-size: .72rem; color: var(--muted); margin-top: .35rem; display: block; }

/* ── STORY CARD ── */
.story {
  background: white;
  border: 1.5px solid var(--border);
  border-radius: 16px;
  padding: 2.25rem;
  margin-bottom: 1.75rem;
  position: relative;
  overflow: hidden;
}

.story::after {
  content: '"';
  position: absolute;
  bottom: -20px; right: 20px;
  font-family: var(--ff);
  font-size: 8rem;
  color: var(--coral-light);
  line-height: 1;
  pointer-events: none;
}

.story h2 {
  font-family: var(--ff);
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
  margin-bottom: 1.1rem;
  letter-spacing: -.03em;
}

.story h2 span { color: var(--coral); font-style: italic; }
.story p { font-size: .87rem; color: var(--muted); line-height: 1.85; margin-bottom: .7rem; }

/* ── SMS ── */
.sms-num {
  font-family: var(--ff);
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--teal);
  text-align: center;
  background: var(--teal-light);
  border: 1.5px solid #b5dcd6;
  border-radius: 14px;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
  letter-spacing: .02em;
}

.stg {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1.25rem;
  margin-bottom: 1.75rem;
}

.stc {
  background: white;
  border: 1.5px solid var(--border);
  border-radius: 14px;
  padding: 1.6rem;
  display: flex;
  flex-direction: column;
  gap: .5rem;
}

.stn {
  font-family: var(--ff);
  font-size: 2.5rem;
  font-weight: 700;
  line-height: 1;
  color: var(--coral-light);
  -webkit-text-stroke: 2px var(--coral-mid);
}

.stc h3 { font-family: var(--ff); font-size: .95rem; font-weight: 600; color: var(--ink); }
.stc p { font-size: .8rem; color: var(--muted); line-height: 1.65; }

/* ── CONTACT ── */
.cg {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1.25rem;
  margin-bottom: 1.75rem;
}

.cc {
  background: white;
  border: 1.5px solid var(--border);
  border-radius: 14px;
  padding: 1.75rem 1.5rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .6rem;
  transition: all .18s;
}

.cc:hover {
  border-color: var(--coral-mid);
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(232,83,58,.1);
}

.cc .ico { font-size: 1.8rem; }
.cc h3 { font-family: var(--ff); font-size: .9rem; font-weight: 600; color: var(--ink); }
.cc p { font-size: .75rem; color: var(--muted); }

/* ── LEGAL ── */
.lg {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1.25rem;
  margin-bottom: 1.75rem;
}

.lc {
  background: white;
  border: 1.5px solid var(--border);
  border-radius: 14px;
  padding: 1.6rem;
  display: flex;
  flex-direction: column;
  gap: .875rem;
}

.lc h3 { font-family: var(--ff); font-size: .95rem; font-weight: 600; color: var(--ink); }
.lc p { font-size: .78rem; color: var(--muted); flex: 1; }

/* ── STACK ── */
.stack { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: 1.75rem; }

.sp {
  font-size: .72rem;
  font-weight: 500;
  color: var(--ink2);
  background: white;
  border: 1.5px solid var(--border);
  padding: 4px 12px;
  border-radius: 100px;
  transition: all .15s;
}

.sp:hover { border-color: var(--coral-mid); color: var(--coral); }

/* ── SOON ── */
.soon-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(275px, 1fr));
  gap: 1.25rem;
  opacity: .55;
  margin-bottom: 2rem;
}

.snc {
  background: white;
  border: 1.5px dashed var(--border);
  border-radius: 14px;
  padding: 1.6rem;
}

.snc h3 { font-family: var(--ff); font-size: .95rem; font-weight: 600; color: var(--ink); margin-bottom: .4rem; }
.snc p { font-size: .78rem; color: var(--muted); }

/* ── DISC ── */
.disc {
  background: var(--amber-light);
  border: 1.5px solid #f0d49a;
  border-radius: 10px;
  padding: .875rem 1.1rem;
  font-size: .75rem;
  color: #8a5c0a;
  margin-top: 1.25rem;
  line-height: 1.65;
}

/* ── ANIM ── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(18px); }
  to { opacity: 1; transform: translateY(0); }
}

.page.active .pt,
.page.active .pb > * {
  animation: fadeUp .4s ease both;
}

