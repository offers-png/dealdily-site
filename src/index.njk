<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DealDily — AI Tools That Work While You Don't</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#06060f;--panel:#0d0d1a;--card:#111120;--card2:#141428;--border:rgba(255,255,255,0.06);--border2:rgba(255,255,255,0.11);--text:#e2e2ef;--muted:#64648a;--dim:rgba(255,255,255,0.28);--indigo:#5b4fff;--indigo2:#4338e0;--teal:#0fd4a4;--amber:#f5a623;--rose:#f43f5e;--sky:#38bdf8;--orange:#ff6b35;--sw:260px;--fh:'Syne',sans-serif;--fb:'DM Sans',sans-serif}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--fb);background:var(--bg);color:var(--text);overflow-x:hidden;line-height:1.6}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}

/* LAYOUT */
.layout{display:flex;min-height:100vh}
.main{margin-left:var(--sw);flex:1;min-width:0;max-width:calc(100vw - var(--sw))}
.page{display:none}.page.active{display:block}

/* SIDEBAR */
.sidebar{width:var(--sw);position:fixed;top:0;left:0;bottom:0;background:var(--panel);border-right:1px solid var(--border);display:flex;flex-direction:column;z-index:200;transition:transform .3s ease}
.sb-logo{padding:1.75rem 1.25rem 1.25rem;border-bottom:1px solid var(--border)}
.sb-brand{display:flex;align-items:center;gap:.5rem;font-family:var(--fh);font-size:1.4rem;font-weight:800;color:#fff;letter-spacing:-.02em}
.sb-dot{width:8px;height:8px;border-radius:50%;background:var(--teal);box-shadow:0 0 12px var(--teal);flex-shrink:0}
.sb-sub{font-size:.62rem;color:var(--muted);letter-spacing:.14em;text-transform:uppercase;margin-top:.35rem}
.sb-nav{flex:1;padding:1rem .625rem;overflow-y:auto}
.sb-nav::-webkit-scrollbar{width:2px}
.sb-nav::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px}
.sb-grp{font-size:.58rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);padding:.75rem .625rem .35rem;opacity:.5}
.sb-btn{display:flex;align-items:center;gap:.65rem;width:100%;padding:.575rem .75rem;border-radius:9px;color:var(--muted);font-size:.85rem;font-weight:500;transition:all .15s;position:relative;text-align:left}
.sb-btn:hover{color:var(--text);background:rgba(255,255,255,.04)}
.sb-btn.on{color:#fff;background:rgba(91,79,255,.14);font-weight:600}
.sb-btn.on::before{content:'';position:absolute;left:0;top:18%;bottom:18%;width:2px;border-radius:0 2px 2px 0;background:linear-gradient(180deg,var(--indigo),#8b5cf6)}
.sb-ico{font-size:.95rem;width:17px;text-align:center;flex-shrink:0}
.sb-badge{margin-left:auto;font-size:.57rem;font-weight:700;padding:2px 6px;border-radius:100px;letter-spacing:.04em;text-transform:uppercase}
.sb-badge.hot{background:rgba(244,63,94,.18);color:var(--rose)}
.sb-badge.new{background:rgba(15,212,164,.13);color:var(--teal)}
.sb-foot{padding:.875rem 1.25rem;border-top:1px solid var(--border);font-size:.72rem;color:var(--muted)}
.sb-foot a{color:var(--muted);transition:color .15s}
.sb-foot a:hover{color:var(--text)}

/* MOB */
.mob-btn{display:none;position:fixed;top:.875rem;left:.875rem;z-index:300;width:38px;height:38px;border-radius:9px;background:var(--panel);border:1px solid var(--border2);color:#fff;font-size:1rem;align-items:center;justify-content:center}
.ovl{display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:150;backdrop-filter:blur(3px)}

/* PAGE TOP */
.pt{padding:2.75rem 2.5rem 2.25rem;border-bottom:1px solid var(--border);position:relative;overflow:hidden}
.pt::after{content:'';position:absolute;top:-80px;right:-80px;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(91,79,255,.16) 0%,transparent 70%);pointer-events:none}
.chip{display:inline-flex;align-items:center;gap:.35rem;font-size:.63rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--indigo);background:rgba(91,79,255,.1);border:1px solid rgba(91,79,255,.22);padding:3px 11px;border-radius:100px;margin-bottom:.875rem}
.pt h1{font-family:var(--fh);font-size:clamp(1.8rem,3vw,2.6rem);font-weight:800;line-height:1.1;letter-spacing:-.03em;color:#fff;margin-bottom:.6rem}
.pt h1 em{font-style:normal;background:linear-gradient(90deg,var(--indigo),var(--teal));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.pt p{color:var(--muted);font-size:.9rem;max-width:500px;line-height:1.7}
.pb{padding:2rem 2.5rem}

/* SECTION LABEL */
.sl{display:flex;align-items:center;gap:.6rem;font-size:.62rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin:1.75rem 0 1.1rem}
.sl::after{content:'';flex:1;height:1px;background:var(--border)}

/* CARD GRID */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(275px,1fr));gap:1px;background:var(--border);border:1px solid var(--border);border-radius:18px;overflow:hidden;margin-bottom:2rem}

/* PRODUCT CARD */
.pc{background:var(--card);padding:1.6rem;display:flex;flex-direction:column;gap:.6rem;position:relative;transition:background .18s}
.pc:hover{background:var(--card2)}
.pcb{position:absolute;top:0;left:0;right:0;height:2px}
.pci{font-size:1.75rem;line-height:1;margin-bottom:.15rem}
.pct{display:inline-block;font-size:.58rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;padding:2px 8px;border-radius:100px}
.t-purple{background:rgba(91,79,255,.14);color:#a78bfa}
.t-green{background:rgba(15,212,164,.1);color:var(--teal)}
.t-yellow{background:rgba(245,166,35,.1);color:var(--amber)}
.t-red{background:rgba(244,63,94,.1);color:var(--rose)}
.t-blue{background:rgba(56,189,248,.1);color:var(--sky)}
.t-pink{background:rgba(236,72,153,.1);color:#f472b6}
.t-cyan{background:rgba(34,211,238,.1);color:#22d3ee}
.t-orange{background:rgba(255,107,53,.1);color:var(--orange)}
.pc h3{font-family:var(--fh);font-size:1rem;font-weight:700;color:#fff;letter-spacing:-.01em}
.pcd{font-size:.82rem;color:var(--muted);line-height:1.65;flex:1}
.pcf{display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding-top:.875rem;border-top:1px solid var(--border);margin-top:auto}
.pcp{font-family:var(--fh);font-size:1.4rem;font-weight:800;color:#fff;line-height:1}
.pcp small{display:block;font-size:.67rem;color:var(--muted);font-weight:400;font-family:var(--fb);margin-top:2px}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:.35rem;font-family:var(--fb);font-size:.78rem;font-weight:600;padding:8px 16px;border-radius:8px;white-space:nowrap;transition:all .18s;text-decoration:none;cursor:pointer;border:none}
.btn-p{background:var(--indigo);color:#fff;box-shadow:0 3px 16px rgba(91,79,255,.28)}
.btn-p:hover{background:var(--indigo2);box-shadow:0 5px 22px rgba(91,79,255,.45);transform:translateY(-1px)}
.btn-g{background:rgba(15,212,164,.13);color:var(--teal);border:1px solid rgba(15,212,164,.28)}
.btn-g:hover{background:rgba(15,212,164,.22);transform:translateY(-1px)}
.btn-ghost{background:rgba(255,255,255,.05);color:var(--dim);border:1px solid var(--border2)}
.btn-ghost:hover{background:rgba(255,255,255,.09);color:var(--text)}

/* AMAZON */
.ag{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1px;background:var(--border);border:1px solid var(--border);border-radius:18px;overflow:hidden;margin-bottom:2rem}
.ac{background:var(--card);display:flex;flex-direction:column;transition:background .18s}
.ac:hover{background:var(--card2)}
.ac:hover .ai img{transform:scale(1.04)}
.ai{aspect-ratio:1;background:var(--panel);overflow:hidden;position:relative}
.ai img{width:100%;height:100%;object-fit:contain;padding:1.25rem;transition:transform .3s ease}
.apb{position:absolute;top:.6rem;right:.6rem;font-family:var(--fh);font-size:.82rem;font-weight:800;color:#fff;background:rgba(255,107,53,.92);backdrop-filter:blur(6px);padding:3px 9px;border-radius:7px}
.ab{padding:1rem 1rem .75rem;flex:1;display:flex;flex-direction:column;gap:.4rem}
.at{font-family:var(--fh);font-size:.82rem;font-weight:700;color:#fff;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.ah{font-size:.75rem;color:var(--muted);line-height:1.55;flex:1;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.af{padding:.6rem 1rem 1rem;display:flex;align-items:center;gap:.6rem;border-top:1px solid var(--border)}
.apr{font-family:var(--fh);font-size:1.15rem;font-weight:800;color:#fff;flex:1}
.abtn{display:inline-flex;align-items:center;gap:.3rem;font-size:.72rem;font-weight:600;padding:7px 13px;border-radius:7px;background:var(--indigo);color:#fff;white-space:nowrap;transition:all .18s;box-shadow:0 2px 12px rgba(91,79,255,.25)}
.abtn:hover{background:var(--indigo2);transform:translateY(-1px)}

/* FILTER */
.fb-wrap{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:1.5rem;align-items:center}
.fl{font-size:.7rem;color:var(--muted);margin-right:.2rem}
.fb{font-size:.72rem;font-weight:500;padding:5px 13px;border-radius:100px;border:1px solid var(--border);background:transparent;color:var(--muted);cursor:pointer;transition:all .15s}
.fb:hover,.fb.on{background:rgba(91,79,255,.14);border-color:rgba(91,79,255,.38);color:#fff}

/* AFF */
.aff-list{display:flex;flex-direction:column;gap:.5rem;margin-bottom:1.75rem}
.aff-row{display:flex;align-items:center;gap:1rem;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:.875rem 1.1rem;transition:all .18s}
.aff-row:hover{border-color:var(--border2);background:var(--card2);transform:translateX(3px)}
.aff-ico{width:40px;height:40px;border-radius:9px;background:rgba(255,255,255,.05);display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0}
.aff-info{flex:1}
.aff-info h4{font-size:.87rem;font-weight:600;color:#fff;margin-bottom:.12rem}
.aff-info p{font-size:.75rem;color:var(--muted)}
.aff-comm{font-size:.62rem;font-weight:700;padding:2px 8px;border-radius:100px;background:rgba(15,212,164,.1);color:var(--teal);white-space:nowrap;flex-shrink:0}
.aff-arr{color:var(--muted);flex-shrink:0}

/* STATS */
.sg{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);border:1px solid var(--border);border-radius:18px;overflow:hidden;margin-bottom:1.75rem}
.sc{background:var(--card);padding:1.75rem 1.5rem;text-align:center}
.sn{font-family:var(--fh);font-size:2.6rem;font-weight:800;color:#fff;line-height:1;display:block;background:linear-gradient(135deg,#fff 30%,var(--muted));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.sl2{font-size:.72rem;color:var(--muted);margin-top:.35rem;display:block}

/* STORY */
.story{background:linear-gradient(135deg,var(--card) 0%,rgba(91,79,255,.07) 100%);border:1px solid var(--border);border-radius:18px;padding:2.25rem;margin-bottom:1.75rem;position:relative;overflow:hidden}
.story::after{content:'';position:absolute;bottom:-50px;right:-50px;width:180px;height:180px;border-radius:50%;background:radial-gradient(circle,rgba(15,212,164,.12) 0%,transparent 70%);pointer-events:none}
.story h2{font-family:var(--fh);font-size:1.5rem;font-weight:800;color:#fff;line-height:1.3;margin-bottom:1.1rem;letter-spacing:-.02em}
.story h2 span{color:var(--teal)}
.story p{font-size:.87rem;color:var(--muted);line-height:1.8;margin-bottom:.7rem}

/* SMS */
.sms-num{font-family:var(--fh);font-size:2.1rem;font-weight:800;color:var(--teal);text-align:center;background:rgba(15,212,164,.05);border:1px solid rgba(15,212,164,.18);border-radius:14px;padding:1.35rem;margin-bottom:1.5rem;letter-spacing:.03em}
.stg{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:1px;background:var(--border);border:1px solid var(--border);border-radius:18px;overflow:hidden;margin-bottom:1.75rem}
.stc{background:var(--card);padding:1.6rem;display:flex;flex-direction:column;gap:.5rem}
.stn{font-family:var(--fh);font-size:2.8rem;font-weight:800;line-height:1;color:rgba(91,79,255,.13)}
.stc h3{font-family:var(--fh);font-size:.95rem;font-weight:700;color:#fff}
.stc p{font-size:.8rem;color:var(--muted);line-height:1.65}

/* CONTACT */
.cg{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1px;background:var(--border);border:1px solid var(--border);border-radius:18px;overflow:hidden;margin-bottom:1.75rem}
.cc{background:var(--card);padding:1.75rem 1.5rem;text-align:center;display:flex;flex-direction:column;align-items:center;gap:.6rem;transition:background .18s}
.cc:hover{background:var(--card2)}
.cc .ico{font-size:1.8rem}
.cc h3{font-family:var(--fh);font-size:.9rem;font-weight:700;color:#fff}
.cc p{font-size:.75rem;color:var(--muted)}

/* LEGAL */
.lg{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:1px;background:var(--border);border:1px solid var(--border);border-radius:18px;overflow:hidden;margin-bottom:1.75rem}
.lc{background:var(--card);padding:1.6rem;display:flex;flex-direction:column;gap:.875rem}
.lc h3{font-family:var(--fh);font-size:.95rem;font-weight:700;color:#fff}
.lc p{font-size:.78rem;color:var(--muted);flex:1}

/* STACK / SOON */
.stack{display:flex;flex-wrap:wrap;gap:.4rem}
.sp{font-size:.72rem;font-weight:500;color:var(--dim);background:rgba(255,255,255,.04);border:1px solid var(--border);padding:4px 11px;border-radius:100px;transition:all .18s}
.sp:hover{color:var(--text);border-color:var(--border2)}
.soon-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(275px,1fr));gap:1px;background:var(--border);border:1px solid var(--border);border-radius:18px;overflow:hidden;opacity:.5;margin-bottom:2rem}
.snc{background:var(--card);padding:1.6rem}
.snc h3{font-family:var(--fh);font-size:.95rem;font-weight:700;color:#fff;margin-bottom:.4rem}
.snc p{font-size:.78rem;color:var(--muted)}

/* DISC */
.disc{background:rgba(245,166,35,.05);border:1px solid rgba(245,166,35,.18);border-radius:9px;padding:.875rem 1.1rem;font-size:.75rem;color:rgba(245,166,35,.75);margin-top:1.25rem;line-height:1.65}

/* ANIM */
@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.page.active .pt,.page.active .pb>*{animation:fadeUp .35s ease both}
.page.active .pb>*:nth-child(1){animation-delay:.04s}
.page.active .pb>*:nth-child(2){animation-delay:.09s}
.page.active .pb>*:nth-child(3){animation-delay:.14s}
.page.active .pb>*:nth-child(4){animation-delay:.19s}
::-webkit-scrollbar{width:3px}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}

/* RESPONSIVE */
@media(max-width:860px){
  .layout{display:block}
  .sidebar{transform:translateX(-100%)}
  .sidebar.open{transform:translateX(0)}
  .main{margin-left:0;max-width:100vw}
  .mob-btn{display:flex}
  .ovl.show{display:block}
  .pt{padding:4rem 1.25rem 1.75rem}
  .pb{padding:1.25rem}
}
@media(max-width:500px){
  .grid,.ag,.stg,.lg,.cg{grid-template-columns:1fr}
  .sg{grid-template-columns:1fr 1fr}
}

/* === GHOSTCHECK STYLES === */
#page-ghostcheck {
  overflow-y: auto;
  height: 100%;
}
  .bebas { font-family: 'Bebas Neue', sans-serif; letter-spacing:0.02em; }

  /* Scan line effect */

  /* Noise */

  /* NAV */
  nav {
    position:fixed; top:0; width:100%; z-index:100;
    background:rgba(10,15,13,0.9);
    backdrop-filter:blur(16px);
    border-bottom:1px solid var(--border);
  }
  .nav-inner { max-width:1100px; margin:auto; padding:0 24px; height:60px; display:flex; align-items:center; justify-content:space-between; }
  .logo { display:flex; align-items:center; gap:8px; }
  .logo-icon { width:28px; height:28px; background:var(--em); border-radius:6px; display:flex; align-items:center; justify-content:center; font-size:14px; }
  .logo-text { font-family:'Bebas Neue',sans-serif; font-size:20px; letter-spacing:0.1em; color:white; }
  .nav-links { display:flex; gap:32px; }
  .nav-links a { font-size:13px; color:var(--slate); text-decoration:none; transition:color .2s; }
  .nav-links a:hover { color:var(--em2); }
  .nav-cta {
    background:var(--em); color:#0a0f0d; font-family:'Bebas Neue',sans-serif;
    font-size:14px; letter-spacing:0.08em; padding:8px 20px; border-radius:6px;
    text-decoration:none; transition:all .2s;
  }
  .nav-cta:hover { background:var(--em2); transform:translateY(-1px); }

  /* HERO */
  .hero {
    min-height:100vh; display:flex; align-items:center;
    padding:100px 24px 60px;
    position:relative; overflow:hidden;
  }
  .hero-grid {
    position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(52,211,153,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(52,211,153,0.03) 1px, transparent 1px);
    background-size:80px 80px;
  }
  .hero-glow {
    position:absolute; top:20%; left:50%; transform:translateX(-50%);
    width:600px; height:600px; border-radius:50%;
    background:radial-gradient(circle, rgba(52,211,153,0.07) 0%, transparent 70%);
    pointer-events:none;
  }
  .hero-inner { max-width:1100px; margin:auto; width:100%; display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center; position:relative; }

  /* BADGE */
  .badge {
    display:inline-flex; align-items:center; gap:8px;
    border:1px solid var(--border); border-radius:100px;
    padding:6px 14px; font-size:11px; letter-spacing:0.15em; text-transform:uppercase;
    color:var(--em); margin-bottom:24px;
  }
  .badge-dot { width:6px; height:6px; border-radius:50%; background:var(--em); animation:pulse 2s ease infinite; }
  @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(0.8)} }

  /* HEADLINE */
  .hero-headline {
    font-family:'Bebas Neue',sans-serif;
    font-size:clamp(52px,7vw,88px);
    line-height:0.95;
    letter-spacing:0.01em;
    margin-bottom:24px;
  }
  .hero-headline .accent { color:var(--em); }
  .hero-headline .cross {
    position:relative; display:inline-block;
    color:var(--slate);
  }
  .hero-headline .cross::after {
    content:'';
    position:absolute; left:0; top:50%;
    width:100%; height:3px;
    background:var(--red); transform:translateY(-50%);
  }

  .hero-sub { color:var(--slate); font-size:16px; line-height:1.7; max-width:460px; margin-bottom:36px; }

  /* TRUST BAR */
  .trust-pills { display:flex; flex-wrap:wrap; gap:10px; margin-bottom:36px; }
  .trust-pill {
    display:flex; align-items:center; gap:6px;
    background:rgba(52,211,153,0.06); border:1px solid var(--border);
    border-radius:100px; padding:6px 14px; font-size:12px; color:var(--em2);
  }

  /* CTA */
  .cta-group { display:flex; flex-wrap:wrap; gap:12px; align-items:center; }
  .btn-primary {
    background:var(--em); color:#0a0f0d;
    font-family:'Bebas Neue',sans-serif; font-size:18px; letter-spacing:0.08em;
    padding:14px 36px; border-radius:8px; text-decoration:none;
    transition:all .25s; display:inline-block; position:relative; overflow:hidden;
  }
  .btn-primary::before {
    content:''; position:absolute; inset:0;
    background:linear-gradient(135deg,transparent 0%,rgba(255,255,255,0.15) 100%);
    opacity:0; transition:opacity .25s;
  }
  .btn-primary:hover { transform:translateY(-2px); box-shadow:0 12px 32px rgba(52,211,153,0.3); }
  .btn-primary:hover::before { opacity:1; }
  .btn-ghost {
    color:var(--slate); font-size:13px; text-decoration:none;
    display:flex; align-items:center; gap:6px; transition:color .2s;
  }
  .btn-ghost:hover { color:var(--em2); }

  /* REPORT CARD */
  .report-card {
    background:var(--card); border:1px solid var(--border);
    border-radius:16px; padding:24px; position:relative;
    animation: float 4s ease-in-out infinite;
  }
  @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
  .report-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; }
  .report-title { font-size:11px; letter-spacing:0.15em; text-transform:uppercase; color:var(--em); }
  .score-badge {
    background:rgba(52,211,153,0.1); border:1px solid rgba(52,211,153,0.3);
