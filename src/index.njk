<style>
:root{--cream:#faf8f4;--warm:#fff9f2;--ink:#1a1614;--ink2:#2d2824;--muted:#7a7168;--muted2:#a09890;--bd:#e8e2d9;--bd2:#d4ccbf;--og:#e8541a;--og2:#c94410;--ogbg:#fff4ee;--ogbr:#f5cdb8;--gn:#1a7a4a;--gnbg:#eef7f2;--gnbr:#b8ddc9;--bl:#1a5caa;--blbg:#eef3fb;--blbr:#b8ccee;--pu:#6b3fa0;--pubg:#f4eefb;--pubr:#d4b8ee;--am:#a06b1a;--ambg:#fdf6ee;--ambr:#eeddbb;--sw:270px}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--cream);color:var(--ink);line-height:1.6;overflow-x:hidden}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
.layout{display:flex;min-height:100vh}
.main{margin-left:var(--sw);flex:1}
.page{display:none}.page.active{display:block}
.sidebar{width:var(--sw);position:fixed;top:0;left:0;bottom:0;background:var(--warm);border-right:1px solid var(--bd);display:flex;flex-direction:column;z-index:200;transition:transform .3s ease}
.sb-logo{padding:1.75rem 1.5rem 1.25rem;border-bottom:1px solid var(--bd)}
.sb-brand{display:flex;align-items:center;gap:.6rem;font-family:'Fraunces',serif;font-size:1.6rem;font-weight:700;color:var(--ink);letter-spacing:-.03em}
.sb-dot{width:10px;height:10px;border-radius:50%;background:var(--og);flex-shrink:0}
.sb-tag{font-size:.68rem;color:var(--muted);margin-top:.3rem;letter-spacing:.04em;text-transform:uppercase;font-weight:500}
.sb-nav{flex:1;padding:1.1rem .75rem;overflow-y:auto}
.sb-nav::-webkit-scrollbar{width:2px}
.sb-nav::-webkit-scrollbar-thumb{background:var(--bd2)}
.sb-grp{font-size:.6rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--muted2);padding:.9rem .6rem .3rem}
.sb-btn{display:flex;align-items:center;gap:.6rem;width:100%;padding:.55rem .75rem;border-radius:8px;color:var(--muted);font-size:.84rem;font-weight:500;transition:all .14s;text-align:left;position:relative}
.sb-btn:hover{color:var(--ink);background:var(--bd)}
.sb-btn.on{color:var(--ink);background:var(--ogbg);font-weight:600}
.sb-btn.on::before{content:'';position:absolute;left:0;top:20%;bottom:20%;width:3px;border-radius:0 2px 2px 0;background:var(--og)}
.sb-ico{font-size:.9rem;width:16px;text-align:center;flex-shrink:0}
.sb-badge{margin-left:auto;font-size:.57rem;font-weight:700;padding:2px 7px;border-radius:100px;letter-spacing:.03em;text-transform:uppercase}
.sb-badge.hot{background:#fdecea;color:#c94410}
.sb-badge.new{background:var(--gnbg);color:var(--gn)}
.sb-amz{display:flex;align-items:center;gap:.6rem;width:100%;padding:.7rem .75rem;border-radius:10px;background:linear-gradient(135deg,#fff8ee,#fff3e0);border:1px solid var(--ambr);color:var(--am);font-size:.84rem;font-weight:700;font-family:'Fraunces',serif;transition:all .15s;margin:.5rem 0}
.sb-amz:hover{background:linear-gradient(135deg,#fff3e0,#fde8c0)}
.sb-amz-b{margin-left:auto;font-size:.55rem;font-weight:800;padding:2px 7px;border-radius:100px;background:var(--ambg);color:var(--am);letter-spacing:.05em;text-transform:uppercase}
.sb-foot{padding:1rem 1.5rem;border-top:1px solid var(--bd);font-size:.72rem;color:var(--muted2)}
.sb-foot a{color:var(--muted);transition:color .14s}
.sb-foot a:hover{color:var(--og)}
.mob-btn{display:none;position:fixed;top:.875rem;left:.875rem;z-index:300;width:40px;height:40px;border-radius:10px;background:var(--warm);border:1px solid var(--bd2);color:var(--ink);font-size:1rem;align-items:center;justify-content:center}
.ovl{display:none;position:fixed;inset:0;background:rgba(26,22,20,.45);z-index:150;backdrop-filter:blur(3px)}
.pt{padding:3.5rem 3rem 2.5rem;border-bottom:1px solid var(--bd)}
.chip{display:inline-flex;align-items:center;gap:.3rem;font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--og);background:var(--ogbg);border:1px solid var(--ogbr);padding:3px 12px;border-radius:100px;margin-bottom:1.1rem}
.pt h1{font-family:'Fraunces',serif;font-size:clamp(2rem,3.5vw,3rem);font-weight:700;line-height:1.15;letter-spacing:-.03em;color:var(--ink);margin-bottom:.7rem}
.pt h1 em{font-style:italic;color:var(--og)}
.pt p{color:var(--muted);font-size:.92rem;max-width:520px;line-height:1.75}
.pb{padding:2.5rem 3rem}
.sl{display:flex;align-items:center;gap:.75rem;font-size:.62rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--muted2);margin:2rem 0 1.25rem}
.sl::after{content:'';flex:1;height:1px;background:var(--bd)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.25rem;margin-bottom:2rem}
.pc{background:white;border:1px solid var(--bd);border-radius:16px;padding:1.75rem;display:flex;flex-direction:column;gap:.6rem;transition:all .2s;position:relative;overflow:hidden}
.pc:hover{border-color:var(--bd2);box-shadow:0 8px 32px rgba(26,22,20,.08);transform:translateY(-2px)}
.pca{position:absolute;top:0;left:0;right:0;height:3px;border-radius:16px 16px 0 0}
.pci{font-size:1.75rem;line-height:1;margin-bottom:.25rem}
.pct{display:inline-block;font-size:.6rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:2px 9px;border-radius:100px}
.t-og{background:var(--ogbg);color:var(--og);border:1px solid var(--ogbr)}
.t-gn{background:var(--gnbg);color:var(--gn);border:1px solid var(--gnbr)}
.t-bl{background:var(--blbg);color:var(--bl);border:1px solid var(--blbr)}
.t-pu{background:var(--pubg);color:var(--pu);border:1px solid var(--pubr)}
.t-am{background:var(--ambg);color:var(--am);border:1px solid var(--ambr)}
.t-ik{background:#f0ede9;color:var(--ink2);border:1px solid var(--bd2)}
.pc h3{font-family:'Fraunces',serif;font-size:1.05rem;font-weight:600;color:var(--ink);letter-spacing:-.02em;line-height:1.3}
.pcd{font-size:.82rem;color:var(--muted);line-height:1.7;flex:1}
.pcf{display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding-top:1rem;border-top:1px solid var(--bd);margin-top:auto}
.pcp{font-family:'Fraunces',serif;font-size:1.45rem;font-weight:700;color:var(--ink);line-height:1}
.pcp small{display:block;font-size:.64rem;color:var(--muted);font-weight:400;font-family:'Plus Jakarta Sans',sans-serif;margin-top:3px}
.btn{display:inline-flex;align-items:center;gap:.35rem;font-family:'Plus Jakarta Sans',sans-serif;font-size:.78rem;font-weight:600;padding:8px 16px;border-radius:8px;white-space:nowrap;transition:all .18s;text-decoration:none;cursor:pointer;border:none}
.btn-p{background:var(--og);color:white;box-shadow:0 2px 12px rgba(232,84,26,.25)}
.btn-p:hover{background:var(--og2);box-shadow:0 4px 18px rgba(232,84,26,.35);transform:translateY(-1px)}
.btn-g{background:var(--gnbg);color:var(--gn);border:1px solid var(--gnbr)}
.btn-g:hover{background:#dff1e8;transform:translateY(-1px)}
.btn-gh{background:white;color:var(--muted);border:1px solid var(--bd2)}
.btn-gh:hover{background:var(--bd);color:var(--ink)}
.ag{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:1.25rem;margin-bottom:2rem}
.ac{background:white;border:1px solid var(--bd);border-radius:14px;display:flex;flex-direction:column;transition:all .2s;overflow:hidden}
.ac:hover{border-color:var(--bd2);box-shadow:0 6px 24px rgba(26,22,20,.07);transform:translateY(-2px)}
.ac:hover .ai img{transform:scale(1.04)}
.ai{aspect-ratio:1;background:#f8f6f3;overflow:hidden;position:relative}
.ai img{width:100%;height:100%;object-fit:contain;padding:1.25rem;transition:transform .3s}
.apb{position:absolute;top:.6rem;right:.6rem;font-family:'Fraunces',serif;font-size:.82rem;font-weight:700;color:white;background:var(--og);padding:3px 9px;border-radius:7px}
.ab{padding:1rem 1rem .75rem;flex:1;display:flex;flex-direction:column;gap:.4rem}
.at{font-family:'Fraunces',serif;font-size:.85rem;font-weight:600;color:var(--ink);line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.ah{font-size:.75rem;color:var(--muted);line-height:1.55;flex:1;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.af{padding:.6rem 1rem 1rem;display:flex;align-items:center;gap:.6rem;border-top:1px solid var(--bd)}
.apr{font-family:'Fraunces',serif;font-size:1.1rem;font-weight:700;color:var(--ink);flex:1}
.abtn{display:inline-flex;align-items:center;gap:.3rem;font-size:.72rem;font-weight:600;padding:7px 13px;border-radius:7px;background:var(--og);color:white;white-space:nowrap;transition:all .18s}
.abtn:hover{background:var(--og2);transform:translateY(-1px)}
.fbw{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:1.75rem;align-items:center}
.fl{font-size:.72rem;color:var(--muted);margin-right:.2rem;font-weight:500}
.fb{font-size:.72rem;font-weight:500;padding:5px 14px;border-radius:100px;border:1px solid var(--bd);background:white;color:var(--muted);cursor:pointer;transition:all .15s}
.fb:hover,.fb.on{background:var(--ogbg);border-color:var(--ogbr);color:var(--og);font-weight:600}
.afl{display:flex;flex-direction:column;gap:.6rem;margin-bottom:1.75rem}
.afr{display:flex;align-items:center;gap:1rem;background:white;border:1px solid var(--bd);border-radius:12px;padding:1rem 1.25rem;transition:all .18s}
.afr:hover{border-color:var(--ogbr);box-shadow:0 4px 16px rgba(232,84,26,.08);transform:translateX(4px)}
.afi{width:42px;height:42px;border-radius:10px;background:var(--ogbg);display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0}
.afn{flex:1}
.afn h4{font-size:.88rem;font-weight:600;color:var(--ink);margin-bottom:.1rem}
.afn p{font-size:.75rem;color:var(--muted)}
.afc{font-size:.62rem;font-weight:700;padding:3px 9px;border-radius:100px;background:var(--gnbg);color:var(--gn);border:1px solid var(--gnbr);white-space:nowrap;flex-shrink:0}
.sg{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:2rem}
.sc{background:white;border:1px solid var(--bd);border-radius:14px;padding:2rem 1.5rem;text-align:center}
.sn{font-family:'Fraunces',serif;font-size:2.8rem;font-weight:800;color:var(--og);line-height:1;display:block;letter-spacing:-.04em}
.sl2{font-size:.72rem;color:var(--muted);margin-top:.4rem;display:block;font-weight:500}
.story{background:linear-gradient(135deg,#fff9f5,#fff4ee);border:1px solid var(--ogbr);border-radius:18px;padding:2.5rem;margin-bottom:2rem}
.story h2{font-family:'Fraunces',serif;font-size:1.6rem;font-weight:700;color:var(--ink);line-height:1.3;margin-bottom:1.1rem;letter-spacing:-.03em}
.story h2 span{color:var(--og);font-style:italic}
.story p{font-size:.87rem;color:var(--muted);line-height:1.85;margin-bottom:.7rem}
.sms-n{font-family:'Fraunces',serif;font-size:2rem;font-weight:800;color:var(--gn);text-align:center;background:var(--gnbg);border:2px solid var(--gnbr);border-radius:14px;padding:1.5rem;margin-bottom:1.75rem;letter-spacing:.02em}
.stg{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1.25rem;margin-bottom:2rem}
.stc{background:white;border:1px solid var(--bd);border-radius:14px;padding:1.75rem;display:flex;flex-direction:column;gap:.5rem}
.stn{font-family:'Fraunces',serif;font-size:3rem;font-weight:800;line-height:1;color:var(--ogbg);-webkit-text-stroke:2px var(--ogbr)}
.stc h3{font-family:'Fraunces',serif;font-size:1rem;font-weight:700;color:var(--ink)}
.stc p{font-size:.8rem;color:var(--muted);line-height:1.7}
.cg{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1.25rem;margin-bottom:2rem}
.cc{background:white;border:1px solid var(--bd);border-radius:14px;padding:2rem 1.5rem;text-align:center;display:flex;flex-direction:column;align-items:center;gap:.6rem;transition:all .2s}
.cc:hover{border-color:var(--ogbr);box-shadow:0 6px 20px rgba(232,84,26,.08);transform:translateY(-2px)}
.cc .ico{font-size:2rem}
.cc h3{font-family:'Fraunces',serif;font-size:.95rem;font-weight:700;color:var(--ink)}
.cc p{font-size:.75rem;color:var(--muted)}
.lg{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1.25rem;margin-bottom:2rem}
.lc{background:white;border:1px solid var(--bd);border-radius:14px;padding:1.75rem;display:flex;flex-direction:column;gap:.875rem}
.lc h3{font-family:'Fraunces',serif;font-size:.95rem;font-weight:700;color:var(--ink)}
.lc p{font-size:.78rem;color:var(--muted);flex:1}
.stack{display:flex;flex-wrap:wrap;gap:.4rem}
.sp{font-size:.72rem;font-weight:500;color:var(--muted);background:white;border:1px solid var(--bd);padding:4px 12px;border-radius:100px;transition:all .15s}
.sp:hover{color:var(--ink);border-color:var(--bd2)}
.soon-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:1.25rem;opacity:.55;margin-bottom:2rem}
.snc{background:white;border:1px solid var(--bd);border-radius:14px;padding:1.75rem}
.snc h3{font-family:'Fraunces',serif;font-size:.95rem;font-weight:700;color:var(--ink);margin-bottom:.4rem}
.snc p{font-size:.78rem;color:var(--muted)}
.disc{background:var(--ambg);border:1px solid var(--ambr);border-radius:10px;padding:.875rem 1.1rem;font-size:.75rem;color:var(--am);margin-top:1.25rem;line-height:1.7}
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.page.active .pt{animation:fadeUp .35s ease both}
.page.active .pb>*{animation:fadeUp .35s ease both}
.page.active .pb>*:nth-child(1){animation-delay:.05s}
.page.active .pb>*:nth-child(2){animation-delay:.1s}
.page.active .pb>*:nth-child(3){animation-delay:.15s}
.page.active .pb>*:nth-child(4){animation-delay:.2s}
::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-thumb{background:var(--bd2);border-radius:4px}
@media(max-width:900px){.layout{display:block}.sidebar{transform:translateX(-100%)}.sidebar.open{transform:translateX(0)}.main{margin-left:0}.mob-btn{display:flex}.ovl.show{display:block}.pt{padding:4rem 1.5rem 2rem}.pb{padding:1.5rem}}
@media(max-width:500px){.grid,.ag,.stg,.lg,.cg{grid-template-columns:1fr}.sg{grid-template-columns:1fr 1fr}}
</style>
</head>
