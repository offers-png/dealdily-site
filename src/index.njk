---
permalink: /index.html
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DealDily — AI Tools That Work While You Don't</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<style>
/* ─── TOKENS ─────────────────────────────────────────────────────────── */
:root {
  --black:   #080810;
  --off:     #0e0e1a;
  --panel:   #13131f;
  --border:  rgba(255,255,255,0.07);
  --border2: rgba(255,255,255,0.12);
  --text:    #e8e8f0;
  --muted:   #7070a0;
  --dim:     rgba(255,255,255,0.35);

  --indigo:  #5b4fff;
  --violet:  #8b5cf6;
  --teal:    #0fd4a4;
  --amber:   #f5a623;
  --rose:    #f43f5e;
  --sky:     #38bdf8;

  --glow-i:  rgba(91,79,255,0.22);
  --glow-t:  rgba(15,212,164,0.18);

  --r-sm:    10px;
  --r-md:    16px;
  --r-lg:    24px;
  --r-xl:    32px;

  --sidebar: 268px;
  --font-head: 'Syne', sans-serif;
  --font-body: 'DM Sans', sans-serif;
}

/* ─── RESET ──────────────────────────────────────────────────────────── */
*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
html { scroll-behavior:smooth; font-size:16px; }
body {
  font-family: var(--font-body);
  background: var(--black);
  color: var(--text);
  overflow-x: hidden;
  line-height:1.6;
}
a { color:inherit; text-decoration:none; }
button { font-family:inherit; cursor:pointer; border:none; background:none; }

/* ─── LAYOUT ─────────────────────────────────────────────────────────── */
.app { display:flex; min-height:100vh; }
.main { margin-left: var(--sidebar); flex:1; min-height:100vh; }
.page { display:none; }
.page.active { display:block; }

/* ─── SIDEBAR ────────────────────────────────────────────────────────── */
.sidebar {
  width: var(--sidebar);
  background: var(--panel);
  border-right: 1px solid var(--border);
  position: fixed; top:0; left:0; bottom:0;
  z-index:200;
  display:flex; flex-direction:column;
  transition: transform .3s cubic-bezier(.4,0,.2,1);
}

.sidebar-logo {
  padding: 2rem 1.5rem 1.5rem;
  border-bottom: 1px solid var(--border);
}
.logo-mark {
  display:flex; align-items:center; gap:.5rem;
  font-family: var(--font-head);
  font-size:1.5rem; font-weight:800;
  color: #fff; letter-spacing:-.02em;
}
.logo-mark .dot {
  width:8px; height:8px;
  background: var(--teal);
  border-radius:50%;
  box-shadow: 0 0 12px var(--teal);
  flex-shrink:0;
}
.logo-sub {
  margin-top:.4rem;
  font-size:.68rem; font-weight:400;
  color: var(--muted);
  letter-spacing:.12em; text-transform:uppercase;
}

.sidebar-nav { flex:1; padding:1.25rem .75rem; overflow-y:auto; }
.sidebar-nav::-webkit-scrollbar { width:2px; }
.sidebar-nav::-webkit-scrollbar-thumb { background:var(--border2); border-radius:2px; }

.nav-group-label {
  font-size:.6rem; font-weight:700;
  letter-spacing:.2em; text-transform:uppercase;
  color: var(--muted);
  padding:.75rem .75rem .4rem;
  opacity:.5;
}

.nav-item {
  display:flex; align-items:center; gap:.7rem;
  width:100%; padding:.6rem .75rem;
  border-radius: var(--r-sm);
  color: var(--muted);
  font-size:.875rem; font-weight:500;
  transition: all .15s;
  position:relative;
  cursor:pointer;
}
.nav-item:hover { color:var(--text); background:rgba(255,255,255,.04); }
.nav-item.active {
  color:#fff; background:rgba(91,79,255,.15);
  font-weight:600;
}
.nav-item.active::before {
  content:'';
  position:absolute; left:0; top:15%; bottom:15%;
  width:2.5px; border-radius:0 2px 2px 0;
  background: linear-gradient(180deg, var(--indigo), var(--violet));
}
.nav-icon { font-size:1rem; flex-shrink:0; width:18px; text-align:center; }
.nav-badge {
  margin-left:auto;
  font-size:.58rem; font-weight:700;
  padding:2px 7px; border-radius:100px;
  letter-spacing:.05em; text-transform:uppercase;
}
.badge-hot { background:rgba(244,63,94,.2); color:var(--rose); }
.badge-new { background:rgba(15,212,164,.15); color:var(--teal); }

.sidebar-foot {
  padding:1rem 1.5rem;
  border-top:1px solid var(--border);
  font-size:.75rem; color:var(--muted);
}
.sidebar-foot a { color:var(--muted); transition:color .15s; }
.sidebar-foot a:hover { color:var(--text); }

/* ─── MOBILE TOGGLE ──────────────────────────────────────────────────── */
.mob-toggle {
  display:none;
  position:fixed; top:1rem; left:1rem; z-index:300;
  width:40px; height:40px; border-radius:10px;
  background:var(--panel); border:1px solid var(--border2);
  color:#fff; font-size:1.1rem;
  align-items:center; justify-content:center;
}
.overlay {
  display:none; position:fixed; inset:0;
  background:rgba(0,0,0,.6); z-index:150;
  backdrop-filter:blur(4px);
}

/* ─── PAGE HERO ──────────────────────────────────────────────────────── */
.page-top {
  padding: 3.5rem 3rem 2.5rem;
  border-bottom:1px solid var(--border);
  position:relative; overflow:hidden;
}
.page-top::before {
  content:'';
  position:absolute; top:-60px; right:-60px;
  width:320px; height:320px; border-radius:50%;
  background: radial-gradient(circle, var(--glow-i) 0%, transparent 70%);
  pointer-events:none;
}
.chip {
  display:inline-flex; align-items:center; gap:.4rem;
  font-size:.68rem; font-weight:700;
  letter-spacing:.1em; text-transform:uppercase;
  color:var(--indigo);
  background:rgba(91,79,255,.12);
  border:1px solid rgba(91,79,255,.25);
  padding:4px 12px; border-radius:100px;
  margin-bottom:1rem;
}
.page-top h1 {
  font-family: var(--font-head);
  font-size: clamp(1.9rem, 3.5vw, 2.8rem);
  font-weight:800; line-height:1.1;
  letter-spacing:-.03em;
  color:#fff; margin-bottom:.75rem;
}
.page-top h1 em {
  font-style:normal;
  background: linear-gradient(90deg, var(--indigo), var(--teal));
  -webkit-background-clip:text; -webkit-text-fill-color:transparent;
  background-clip:text;
}
.page-top p {
  color:var(--muted); font-size:.95rem;
  max-width:520px; line-height:1.7;
}

/* ─── PAGE BODY ──────────────────────────────────────────────────────── */
.page-body { padding:2.5rem 3rem; }

/* ─── SECTION LABEL ──────────────────────────────────────────────────── */
.sec-label {
  display:flex; align-items:center; gap:.75rem;
  font-size:.65rem; font-weight:700;
  letter-spacing:.18em; text-transform:uppercase;
  color:var(--muted); margin: 2rem 0 1.25rem;
}
.sec-label::after { content:''; flex:1; height:1px; background:var(--border); }

/* ─── CARD GRID ──────────────────────────────────────────────────────── */
.card-grid {
  display:grid;
  grid-template-columns: repeat(auto-fill, minmax(290px,1fr));
  gap:1px;
  background:var(--border);
  border-radius:var(--r-lg);
  overflow:hidden;
  border:1px solid var(--border);
  margin-bottom:2.5rem;
}

/* ─── PRODUCT CARD ───────────────────────────────────────────────────── */
.pcard {
  background:var(--panel);
  padding:1.75rem;
  display:flex; flex-direction:column;
  gap:.75rem;
  transition:background .2s;
  position:relative;
}
.pcard:hover { background:rgba(255,255,255,.03); }
.pcard-accent {
  position:absolute; top:0; left:0; right:0;
  height:2px;
  background:var(--accent-color, var(--indigo));
}
.pcard-icon {
  font-size:1.8rem; line-height:1;
  margin-bottom:.25rem;
}
.pcard-tag {
  display:inline-block;
  font-size:.6rem; font-weight:700;
  letter-spacing:.1em; text-transform:uppercase;
  padding:3px 9px; border-radius:100px;
}
.t-purple { background:rgba(91,79,255,.15); color:#a78bfa; }
.t-green  { background:rgba(15,212,164,.12); color:var(--teal); }
.t-yellow { background:rgba(245,166,35,.12); color:var(--amber); }
.t-red    { background:rgba(244,63,94,.12);  color:var(--rose); }
.t-blue   { background:rgba(56,189,248,.12); color:var(--sky); }
.t-pink   { background:rgba(236,72,153,.12); color:#f472b6; }
.t-cyan   { background:rgba(34,211,238,.12); color:#22d3ee; }
.t-orange { background:rgba(249,115,22,.12); color:#fb923c; }

.pcard h3 {
  font-family: var(--font-head);
  font-size:1.05rem; font-weight:700;
  color:#fff; letter-spacing:-.01em;
}
.pcard-desc {
  font-size:.85rem; color:var(--muted);
  line-height:1.65; flex:1;
}
.pcard-foot {
  display:flex; align-items:center;
  justify-content:space-between;
  padding-top:1rem;
  border-top:1px solid var(--border);
  gap:.75rem; margin-top:auto;
}
.pcard-price {
  font-family: var(--font-head);
  font-size:1.5rem; font-weight:800;
  color:#fff; line-height:1;
}
.pcard-price small {
  display:block; font-size:.7rem;
  color:var(--muted); font-weight:400;
  font-family:var(--font-body);
  margin-top:2px;
}

/* ─── BUTTONS ────────────────────────────────────────────────────────── */
.btn {
  display:inline-flex; align-items:center; gap:.4rem;
  font-family:var(--font-body);
  font-size:.8rem; font-weight:600;
  padding:9px 18px; border-radius:var(--r-sm);
  border:none; cursor:pointer;
  white-space:nowrap; transition:all .2s;
  text-decoration:none;
}
.btn-primary {
  background:var(--indigo); color:#fff;
  box-shadow:0 4px 20px rgba(91,79,255,.3);
}
.btn-primary:hover {
  background:#4a3fee;
  box-shadow:0 6px 28px rgba(91,79,255,.5);
  transform:translateY(-1px);
}
.btn-teal {
  background:rgba(15,212,164,.15);
  color:var(--teal);
  border:1px solid rgba(15,212,164,.3);
}
.btn-teal:hover { background:rgba(15,212,164,.25); transform:translateY(-1px); }
.btn-ghost {
  background:rgba(255,255,255,.05);
  color:var(--dim);
  border:1px solid var(--border2);
}
.btn-ghost:hover { background:rgba(255,255,255,.08); color:var(--text); }

/* ─── AFFILIATE ROWS ─────────────────────────────────────────────────── */
.aff-list { display:flex; flex-direction:column; gap:.6rem; margin-bottom:2rem; }
.aff-row {
  display:flex; align-items:center; gap:1.25rem;
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:var(--r-md);
  padding:1rem 1.25rem;
  text-decoration:none; color:inherit;
  transition:all .2s;
}
.aff-row:hover {
  border-color:var(--border2);
  background:rgba(255,255,255,.03);
  transform:translateX(4px);
}
.aff-emo {
  width:44px; height:44px; border-radius:10px;
  background:rgba(255,255,255,.05);
  display:flex; align-items:center; justify-content:center;
  font-size:1.4rem; flex-shrink:0;
}
.aff-text { flex:1; }
.aff-text h4 { font-size:.9rem; font-weight:600; color:#fff; margin-bottom:.15rem; }
.aff-text p { font-size:.78rem; color:var(--muted); }
.aff-comm {
  font-size:.65rem; font-weight:700;
  padding:3px 9px; border-radius:100px;
  background:rgba(15,212,164,.1); color:var(--teal);
  white-space:nowrap; flex-shrink:0;
}
.aff-arr { color:var(--muted); flex-shrink:0; font-size:.9rem; }

/* ─── ABOUT STATS ────────────────────────────────────────────────────── */
.stat-row {
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:1px; background:var(--border);
  border:1px solid var(--border);
  border-radius:var(--r-lg); overflow:hidden;
  margin-bottom:2rem;
}
.stat-cell {
  background:var(--panel);
  padding:2rem 1.5rem; text-align:center;
}
.stat-num {
  font-family: var(--font-head);
  font-size:2.8rem; font-weight:800;
  color:#fff; line-height:1; display:block;
  background: linear-gradient(135deg, #fff 40%, var(--muted));
  -webkit-background-clip:text; -webkit-text-fill-color:transparent;
  background-clip:text;
}
.stat-label {
  font-size:.75rem; color:var(--muted);
  margin-top:.4rem; display:block;
  letter-spacing:.05em;
}

/* ─── STORY BLOCK ────────────────────────────────────────────────────── */
.story-block {
  border:1px solid var(--border);
  border-radius:var(--r-lg);
  padding:2.5rem;
  background: linear-gradient(135deg, var(--panel) 0%, rgba(91,79,255,.06) 100%);
  margin-bottom:2rem;
  position:relative; overflow:hidden;
}
.story-block::after {
  content:'';
  position:absolute; bottom:-40px; right:-40px;
  width:200px; height:200px; border-radius:50%;
  background:radial-gradient(circle, var(--glow-t) 0%, transparent 70%);
  pointer-events:none;
}
.story-block h2 {
  font-family:var(--font-head);
  font-size:1.6rem; font-weight:800;
  color:#fff; line-height:1.3;
  margin-bottom:1.25rem; letter-spacing:-.02em;
}
.story-block h2 span { color:var(--teal); }
.story-block p {
  font-size:.9rem; color:var(--muted);
  line-height:1.8; margin-bottom:.75rem;
}

/* ─── SMS PAGE ───────────────────────────────────────────────────────── */
.sms-hero-num {
  font-family:var(--font-head);
  font-size:2.4rem; font-weight:800;
  color:var(--teal); text-align:center;
  background:rgba(15,212,164,.06);
  border:1px solid rgba(15,212,164,.2);
  border-radius:var(--r-md);
  padding:1.5rem;
  margin-bottom:1.5rem;
  letter-spacing:.04em;
  box-shadow:0 0 40px rgba(15,212,164,.06);
}

/* ─── CONTACT CARDS ──────────────────────────────────────────────────── */
.contact-grid {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:1px; background:var(--border);
  border:1px solid var(--border);
  border-radius:var(--r-lg); overflow:hidden;
  margin-bottom:2rem;
}
.contact-cell {
  background:var(--panel);
  padding:2rem 1.5rem; text-align:center;
  display:flex; flex-direction:column; align-items:center; gap:.75rem;
  text-decoration:none; color:inherit;
  transition:background .2s;
}
.contact-cell:hover { background:rgba(255,255,255,.03); }
.contact-cell .ico { font-size:2rem; }
.contact-cell h3 { font-family:var(--font-head); font-size:.95rem; font-weight:700; color:#fff; }
.contact-cell p { font-size:.8rem; color:var(--muted); }

/* ─── LEGAL CARDS ────────────────────────────────────────────────────── */
.legal-grid {
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(240px,1fr));
  gap:1px; background:var(--border);
  border:1px solid var(--border);
  border-radius:var(--r-lg); overflow:hidden;
  margin-bottom:2rem;
}
.legal-cell {
  background:var(--panel);
  padding:1.75rem;
  display:flex; flex-direction:column; gap:1rem;
}
.legal-cell h3 { font-family:var(--font-head); font-size:1rem; font-weight:700; color:#fff; }
.legal-cell p { font-size:.82rem; color:var(--muted); flex:1; }

/* ─── STACK TAGS ─────────────────────────────────────────────────────── */
.stack-wrap { display:flex; flex-wrap:wrap; gap:.5rem; }
.stack-pill {
  font-size:.75rem; font-weight:500;
  color:var(--dim); background:rgba(255,255,255,.04);
  border:1px solid var(--border);
  padding:5px 12px; border-radius:100px;
  transition:all .2s;
}
.stack-pill:hover { color:var(--text); border-color:var(--border2); }

/* ─── DISCLOSURE ─────────────────────────────────────────────────────── */
.disclosure {
  background:rgba(245,166,35,.06);
  border:1px solid rgba(245,166,35,.2);
  border-radius:var(--r-sm);
  padding:1rem 1.25rem;
  font-size:.78rem; color:rgba(245,166,35,.8);
  margin-top:1.5rem; line-height:1.65;
}

/* ─── STEP CARDS ─────────────────────────────────────────────────────── */
.steps-grid {
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
  gap:1px; background:var(--border);
  border:1px solid var(--border);
  border-radius:var(--r-lg); overflow:hidden;
  margin-bottom:2rem;
}
.step-cell {
  background:var(--panel);
  padding:1.75rem;
  display:flex; flex-direction:column; gap:.6rem;
}
.step-num {
  font-family:var(--font-head);
  font-size:3rem; font-weight:800; line-height:1;
  color:rgba(91,79,255,.15);
}
.step-cell h3 { font-family:var(--font-head); font-size:1rem; font-weight:700; color:#fff; }
.step-cell p { font-size:.82rem; color:var(--muted); line-height:1.65; }

/* ─── COMING SOON ────────────────────────────────────────────────────── */
.soon-grid {
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(290px,1fr));
  gap:1px; background:var(--border);
  border:1px solid var(--border);
  border-radius:var(--r-lg); overflow:hidden;
  opacity:.55; margin-bottom:2.5rem;
}
.soon-cell { background:var(--panel); padding:1.75rem; }
.soon-cell h3 { font-family:var(--font-head); font-size:1rem; font-weight:700; color:#fff; margin-bottom:.5rem; }
.soon-cell p { font-size:.82rem; color:var(--muted); }

/* ─── ANIMATIONS ─────────────────────────────────────────────────────── */
@keyframes fadeUp {
  from { opacity:0; transform:translateY(16px); }
  to   { opacity:1; transform:translateY(0); }
}
.page.active .page-top,
.page.active .page-body > * {
  animation: fadeUp .4s ease both;
}
.page.active .page-body > *:nth-child(1) { animation-delay:.05s; }
.page.active .page-body > *:nth-child(2) { animation-delay:.1s; }
.page.active .page-body > *:nth-child(3) { animation-delay:.15s; }
.page.active .page-body > *:nth-child(4) { animation-delay:.2s; }

/* ─── SCROLLBAR ──────────────────────────────────────────────────────── */
::-webkit-scrollbar { width:4px; }
::-webkit-scrollbar-track { background:transparent; }
::-webkit-scrollbar-thumb { background:var(--border2); border-radius:4px; }

/* ─── RESPONSIVE ─────────────────────────────────────────────────────── */
@media(max-width:900px) {
  :root { --sidebar:0px; }
  .sidebar { transform:translateX(-268px); width:268px; }
  .sidebar.open { transform:translateX(0); }
  .main { margin-left:0; }
  .mob-toggle { display:flex; }
  .overlay.show { display:block; }
  .page-top { padding:4.5rem 1.5rem 2rem; }
  .page-body { padding:1.5rem; }
}
@media(max-width:600px) {
  .card-grid,
  .steps-grid,
  .soon-grid,
  .legal-grid,
  .contact-grid { grid-template-columns:1fr; }
  .stat-row { grid-template-columns:1fr 1fr; }
}
</style>
</head>
<body>

<button class="mob-toggle" onclick="toggleSidebar()">☰</button>
<div class="overlay" id="overlay" onclick="toggleSidebar()"></div>

<div class="app">

<!-- ══════════════════════════════════════════════════════
     SIDEBAR
════════════════════════════════════════════════════════ -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar-logo">
    <div class="logo-mark">
      <div class="dot"></div>
      DealDily
    </div>
    <div class="logo-sub">AI Tools · Automations · Deals</div>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-group-label">Main</div>

    <button class="nav-item active" onclick="nav('saas',this)">
      <span class="nav-icon">🛠</span> SaaS Tools
      <span class="nav-badge badge-hot">{{ site.saas_tools.length }}</span>
    </button>
    <button class="nav-item" onclick="nav('workflows',this)">
      <span class="nav-icon">🔄</span> AI Workflows
    </button>
    <button class="nav-item" onclick="nav('automations',this)">
      <span class="nav-icon">⚡</span> Automations
    </button>
    <button class="nav-item" onclick="nav('affiliates',this)">
      <span class="nav-icon">💰</span> Affiliate Deals
      <span class="nav-badge badge-new">New</span>
    </button>

    <div class="nav-group-label">Services</div>
    <button class="nav-item" onclick="nav('sms',this)">
      <span class="nav-icon">📲</span> SMS Service
    </button>
    <button class="nav-item" onclick="nav('about',this)">
      <span class="nav-icon">👤</span> About / Story
    </button>
    <button class="nav-item" onclick="nav('contact',this)">
      <span class="nav-icon">✉️</span> Contact
    </button>

    <div class="nav-group-label">Legal</div>
    <button class="nav-item" onclick="nav('legal',this)">
      <span class="nav-icon">📋</span> Legal & Compliance
    </button>
  </nav>

  <div class="sidebar-foot">
    <a href="mailto:contact@dealdily.com">✉ contact@dealdily.com</a>
  </div>
</aside>

<!-- ══════════════════════════════════════════════════════
     MAIN CONTENT
════════════════════════════════════════════════════════ -->
<main class="main">

<!-- ─── SAAS TOOLS ───────────────────────────────────── -->
<div class="page active" id="page-saas">
  <div class="page-top">
    <div class="chip">🛠 SaaS Tools</div>
