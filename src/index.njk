<script>
function go(name, btn) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.sb-btn').forEach(b => b.classList.remove('on'));
  document.getElementById('page-' + name).classList.add('active');
  btn.classList.add('on');
  window.scrollTo(0, 0);
  if (window.innerWidth <= 860) {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('ovl').classList.remove('show');
  }
}
function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('ovl').classList.toggle('show');
}
function amzF(cat, btn) {
  document.querySelectorAll('.fb').forEach(b => b.classList.remove('on'));
  btn.classList.add('on');
  document.querySelectorAll('.ac').forEach(c => {
    c.style.display = (cat === 'all' || c.dataset.cat === cat) ? 'flex' : 'none';
  });
}
</script>
