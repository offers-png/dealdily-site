<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — DealDily</title>
<meta name="description" content="{{ title }}{% if price %} — {{ price }}{% if discount %}, {{ discount }} off{% endif %}{% endif %}. Amazon deal via DealDily.">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#06060f;--surface:#0d0d1a;--card:#111120;
  --border:rgba(255,255,255,0.07);--border2:rgba(255,255,255,0.13);
  --text:#e2e2ef;--muted:#64648a;
  --indigo:#5b4fff;--teal:#0fd4a4;--amazon:#ff9900;--amazon2:#e68a00;
  --fh:'Syne',sans-serif;--fb:'DM Sans',sans-serif
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--fb);background:var(--bg);color:var(--text);line-height:1.6;min-height:100vh}
a{color:inherit;text-decoration:none}

/* HEADER */
.header{background:var(--surface);border-bottom:1px solid var(--border);padding:1rem 1.5rem;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
.logo{display:flex;align-items:center;gap:.5rem;font-family:var(--fh);font-size:1.3rem;font-weight:800;color:#fff;letter-spacing:-.02em}
.logo-dot{width:7px;height:7px;border-radius:50%;background:var(--teal);box-shadow:0 0 10px var(--teal)}
.header-back{font-size:.8rem;color:var(--muted);display:flex;align-items:center;gap:.35rem;transition:color .15s}
.header-back:hover{color:var(--text)}

/* LAYOUT */
.page{max-width:820px;margin:0 auto;padding:2rem 1.5rem 4rem}

/* PRODUCT HERO */
.product-card{background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden;margin-bottom:2rem}
.product-img{width:100%;height:320px;background:var(--surface);display:flex;align-items:center;justify-content:center;border-bottom:1px solid var(--border)}
.product-img img{max-width:100%;max-height:100%;object-fit:contain;padding:1.5rem}
.product-img-placeholder{font-size:5rem;opacity:.2}
.product-info{padding:1.75rem}
.product-badges{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:.875rem}
.badge-cat{font-size:.62rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;padding:3px 10px;border-radius:100px;background:rgba(91,79,255,.14);color:#a78bfa}
.badge-discount{font-size:.62rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;padding:3px 10px;border-radius:100px;background:rgba(15,212,164,.13);color:var(--teal)}
.product-title{font-family:var(--fh);font-size:clamp(1.35rem,3vw,1.9rem);font-weight:800;color:#fff;line-height:1.2;letter-spacing:-.025em;margin-bottom:1.25rem}
.price-row{display:flex;align-items:baseline;gap:.75rem;flex-wrap:wrap;margin-bottom:1.5rem}
.price-now{font-family:var(--fh);font-size:2.5rem;font-weight:800;color:var(--amazon);line-height:1}
.price-was{font-size:1.1rem;color:var(--muted);text-decoration:line-through}
.price-save{font-size:.82rem;font-weight:700;color:var(--teal);background:rgba(15,212,164,.1);padding:3px 10px;border-radius:100px}
.buy-btn{
  display:flex;align-items:center;justify-content:center;gap:.6rem;
  width:100%;padding:1rem 1.5rem;border-radius:12px;
  background:linear-gradient(135deg,var(--amazon),var(--amazon2));
  color:#000;font-family:var(--fh);font-size:1rem;font-weight:800;
  letter-spacing:-.01em;transition:all .2s;
  box-shadow:0 4px 20px rgba(255,153,0,.3);cursor:pointer;
}
.buy-btn:hover{box-shadow:0 6px 30px rgba(255,153,0,.45);transform:translateY(-1px)}
.post-date{font-size:.75rem;color:var(--muted);margin-top:1rem;display:flex;align-items:center;gap:.3rem}
.post-date::before{content:'📅';font-size:.7rem}

/* POST BODY */
.post-body{font-size:.95rem;line-height:1.8;color:var(--text)}
.post-body h1,.post-body h2,.post-body h3{font-family:var(--fh);color:#fff;margin:1.5rem 0 .75rem;line-height:1.25;letter-spacing:-.02em}
.post-body h1{font-size:1.4rem}
.post-body h2{font-size:1.2rem}
.post-body p{margin-bottom:1rem;color:#b8b8d4}
.post-body strong{color:#fff;font-weight:700}
.post-body em{font-style:italic;color:var(--muted)}
.post-body del{text-decoration:line-through;color:var(--muted)}
.post-body a{color:var(--amazon);text-decoration:underline;text-underline-offset:3px}
.post-body a:hover{color:#ffaa33}
.post-body ul,post-body ol{margin:.75rem 0 1rem 1.5rem}
.post-body li{margin-bottom:.35rem;color:#b8b8d4}
.post-body blockquote{border-left:3px solid var(--indigo);padding-left:1rem;color:var(--muted);font-style:italic;margin:1rem 0}

/* BACK LINK */
.back-section{margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid var(--border);display:flex;gap:1rem;flex-wrap:wrap}
.back-btn{display:inline-flex;align-items:center;gap:.4rem;font-size:.82rem;font-weight:600;color:var(--muted);border:1px solid var(--border2);padding:.5rem 1rem;border-radius:8px;transition:all .15s}
.back-btn:hover{color:var(--text);border-color:rgba(255,255,255,.25)}

/* MOBILE */
@media(max-width:600px){
  .page{padding:1.25rem 1rem 3rem}
  .product-img{height:220px}
  .price-now{font-size:2rem}
  .header{padding:.875rem 1rem}
}
</style>
</head>
<body>

<header class="header">
  <a class="logo" href="/"><span class="logo-dot"></span>DealDily</a>
  <a class="header-back" href="/amazon-deals/">← All Amazon Deals</a>
</header>

<div class="page">
  <div class="product-card">
    <div class="product-img">
      {% if image %}
      <img src="{{ image }}" alt="{{ title }}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
      <span class="product-img-placeholder" style="display:none">🛒</span>
      {% else %}
      <span class="product-img-placeholder">🛒</span>
      {% endif %}
    </div>
    <div class="product-info">
      <div class="product-badges">
        {% if category %}<span class="badge-cat">{{ category | categoryLabel }}</span>{% endif %}
        {% if discount %}<span class="badge-discount">{{ discount }} off</span>{% endif %}
      </div>
      <h1 class="product-title">{{ title }}</h1>
      <div class="price-row">
        {% if price %}<span class="price-now">{{ price }}</span>{% endif %}
        {% if original_price %}<span class="price-was">{{ original_price }}</span>{% endif %}
        {% if discount %}<span class="price-save">Save {{ discount }}</span>{% endif %}
      </div>
      {% if affiliate_link %}
      <a class="buy-btn" href="{{ affiliate_link }}" target="_blank" rel="noopener sponsored">
        🛒 Buy on Amazon →
      </a>
      {% endif %}
      {% if date %}<div class="post-date">{{ date | date("MMMM d, yyyy") }}</div>{% endif %}
    </div>
  </div>

  <div class="post-body">
    {{ content | safe }}
  </div>

  <div class="back-section">
    <a class="back-btn" href="/amazon-deals/">← Back to all deals</a>
    <a class="back-btn" href="/">DealDily Home</a>
  </div>
</div>

</body>
</html>
